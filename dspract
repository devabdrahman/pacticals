#step 2: convert XML elements into python dictionary
def xml_to_dict(elements):
# If the elements has no child elements
    if(len(elements)) == 0:
        return elements.text.strip() if elements.text else ""
    data = {}
    for child in elements:
        child_data = xml_to_dict(child)
        #Handle repeated elements
        if child.tag in data:
            if not isinstance(data[child.tag], list):
                data[child.tag] = [data[child.tag]]
            data[child.tag].append(child_data)
        else:
            data[child.tag] = child_data
    return data
#sTEP 3: convert xml to horus
def xml_to_horus(input_file, output_file):
    tree = ET.parse(input_file)
    root = tree.getroot()
    data = xml_to_dict(root)
    horus = {
        "horus_version":"1.0",
        "source_format":"XML",
        "root":root.tag,
        "data":data
    }
    #save horus output
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(horus, f, indent=4)
    return horus
# Step4 : perform conversion
output_file = "students_horus.xml.json"
horus_data = xml_to_horus(xml_file, output_file)
# step5: display hours output
