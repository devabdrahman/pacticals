# ---------- Video to horus ----------
import os
import cv2
import shutil
import numpy as np
import pandas as pd
from google.colab import files
#step1: Uploaded video
print("Upload your video file")
uploaded = files.upload()
video_name = next(iter(uploaded))
video_path = "/content/"+video_name
#create temperory founder for frames
frame_folder = "/content/temp"
if os.path.exists(frame_folder):
    shutil.rmtree(frame_folder)
os.makedirs(frame_folder)
print("\nStart Movie to Frames")
#step 3: open video
vidcap = cv2.VideoCapture(video_path)
if not vidcap.isOpened():
    raise ValueError("Unable to open video, please upload a valid video file")
fps = vidcap.get(cv2.CAP_PROP_FPS)
if fps <= 0:
    fps = 30
total_frames = int(vidcap.get(cv2.CAP_PROP_FRAME_COUNT))
duration = total_frames/fps
print("Video FPS ", fps)
print("Total Video frames: ", total_frames)
print("Duration in seconds: ", round(duration))
#Extract approximately one frame per second
frame_interval = max(1, int(fps))
count = 0
frame_number = 0
while True:
    success, image = vidcap.read()
    if not success:
        break
    if frame_number % frame_interval == 0:
        frame_path = os.path.join(
            frame_folder,f"frame-{count:04d}.jpg"
        )
        cv2.imwrite(frame_path,image)
        count += 1
    frame_number += 1
vidcap.release()
print("\nGenerated", count, "frames")
print("Movie to Frames - Done")
#step 4: Converted extracted frames to HOURS data
print("Start Frames to HORUS")
records = []
#Resize each frame to keep output manageable
for frame_file in sorted(os.listdir(frame_folder)):
    if not frame_file.lower().endswith((".jpg", ".jpeg", ".png")):
        continue
    frame_path = os.path.join(frame_folder, frame_file)
    image = cv2.imread(frame_path)
    if image is None:
        continue
    #Resize image
    image = cv2.resize(image, (32, 32))
    #convert BGR to RGB
    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    height, width, channels = image.shape
    #read every pixel
    for y in range(height):
        for x in range(width):
            red, green, blue = image[y, x]
            records.append({
                "XAxis": x,
                "YAxis": y,
                "Red": red,
                "Green": green,
                "Blue": blue,
                "Alpha": 255,
                "FileName": frame_file
            })
#step 5: create horus Dataframe
columns = [
"XAxis",
"YAxis",
"Red",
"Green",
"Blue",
"Alpha",
"FileName"
]
ProcessedData = pd.DataFrame(records, columns = columns)
print("\nHORUS Data Preview")
print(ProcessedData.head(10))
print("\nRows:", ProcessData.shape[0])
print("Columns: ", ProcessData.shape[1])
#step 6: save horus outpout to csv
