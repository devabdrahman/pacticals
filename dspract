def create_distance_function(a,b,c):
  """
  0=ax+y+c
  """
  def distance(x,y):
    """
    return tuple(d,pos)
    d is the distance
    If pos == -1 point is below the line.
    0 on the line and +1 if above the line
    """

    nom = a * x + b * y + c
    if nom == 0:
      pos = 0
    elif(nom<0 and b<0) or (nom>0 and b>0):
      pos=-1
    else:
      pos=1

    return(np.absolute(nom)/np.sqrt(a**2 + b**2),pos)
  return distance
