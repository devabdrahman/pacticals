#step2 : convert csv to HOURS format
def csv_to_hours(input_file, output_file):
    records =[]
    with open(input_file, "r") as f:
        reader = csv.DictReader(f)
        for row in reader:
            records.append({
                "type":"record",
                "data": dict(row)
            })
    hours = {
        "horus_version":"1.0",
        "source_format": "CSV",
        "records":records
    }
    #save hours outpout
    with open(output_file,"w",encoding="utf-8") as f:
        json.dump(hours, f, indent = 4)
    return hours
#step 3: perform converstion
output_file = "students_horus.json"
